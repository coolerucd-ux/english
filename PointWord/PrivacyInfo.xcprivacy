<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- PointWord does not track users across apps/sites owned by other companies. -->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- No tracking domains: the app talks only to its own word-lookup backend. -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- No data is linked to the user's identity or used for tracking.
	     Word text + surrounding context are sent to the lookup backend to
	     produce a definition; they are not tied to an identity, not used for
	     tracking, and no images ever leave the device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!-- Required Reason APIs actually used by the app. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<!-- @AppStorage (hasOnboarded / appLanguage) is backed by UserDefaults. -->
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: access info stored by this app only. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
